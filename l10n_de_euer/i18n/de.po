#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "§ 7 (2a) EStG applies to acquired vehicles only."
msgstr "§ 7 Abs. 2a EStG gilt nur für angeschaffte Fahrzeuge."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "§ 7 (2a) EStG applies to electric vehicles delivered from 1 July 2025 to 31 December 2027 only."
msgstr "§ 7 Abs. 2a EStG gilt nur für Elektrofahrzeuge, die vom 01.07.2025 bis 31.12.2027 angeschafft werden."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "§ 7 (2a) EStG is for purely electric vehicles only (§ 9 (2) KraftStG), not for plug-in hybrids."
msgstr "§ 7 Abs. 2a EStG gilt nur für reine Elektrofahrzeuge (§ 9 Abs. 2 KraftStG), nicht für Plug-in-Hybride."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "§ 7 (2a) EStG: only events in the year of delivery are supported."
msgstr "§ 7 Abs. 2a EStG: Nur Ereignisse im Lieferjahr werden unterstützt."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "§ 7b EStG applies to buildings (new rented flats) only."
msgstr "§ 7b EStG gilt nur für Gebäude (neue Mietwohnungen)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "§ 7b EStG: special depreciation only in the year of delivery and the three following years."
msgstr "§ 7b EStG: Sonderabschreibung nur im Jahr der Lieferung und in den drei folgenden Jahren."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "§ 7b EStG: special depreciation only next to linear or manual depreciation (§ 7 (4) or (5a) EStG)."
msgstr "§ 7b EStG: Sonderabschreibung nur neben linearer oder manueller AfA (§ 7 Abs. 4 oder 5a EStG)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "§ 7g (5) EStG applies to movable assets only."
msgstr "§ 7g Abs. 5 EStG gilt nur für bewegliche Wirtschaftsgüter."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "§ 7g (5) EStG: special depreciation only in the year of delivery and the four following years."
msgstr "§ 7g Abs. 5 EStG: Sonderabschreibung nur im Lieferjahr und den vier folgenden Jahren."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "§ 7g (5) EStG: special depreciation only next to linear or degressive depreciation."
msgstr "§ 7g Abs. 5 EStG: Sonderabschreibung nur neben linearer oder degressiver AfA."

