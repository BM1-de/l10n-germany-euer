msgstr "Der amtliche Vordruck lässt in diesem Feld einen negativen Wert zu."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_parameter.py:0
msgid "The periods of parameter %(code)s overlap."
msgstr "Die Zeiträume des Parameters %(code)s überschneiden sich."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_account_assignment.py:0
msgid "The periods of the assignments of account %(account)s overlap."
msgstr "Die Zeiträume der Zuordnungen von Konto %(account)s überschneiden sich."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_assignment_checker.py:0
