#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_assignment_checker.py:0
msgid "%(account)s (%(category)s) has %(count)s posted lines in %(year)s. This value is entered as profit correction, not taken from bookings."
msgstr "%(account)s (%(category)s) hat %(count)s gebuchte Zeilen in %(year)s. Dieser Wert wird als Gewinnkorrektur erfasst, nicht aus Buchungen übernommen."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_assignment_checker.py:0
msgid "%(account)s (%(category)s) has %(count)s posted lines in %(year)s: %(reason)s."
msgstr "%(account)s (%(category)s) hat %(count)s gebuchte Zeilen in %(year)s: %(reason)s."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(account)s is a neutral balance sheet account without reconciliation. It is the counter account of money movements and of income or expense lines in %(move)s; the expense would be lost. Make the account reconcilable and book the invoice as document."
msgstr "%(account)s ist ein neutrales Bilanzkonto ohne Ausgleich. Es ist Gegenkonto von Geldbewegungen und von Ertrags- oder Aufwandszeilen in %(move)s; der Aufwand ginge verloren. Setzen Sie das Konto abstimmbar und erfassen Sie die Rechnung als Beleg."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_assignment_checker.py:0
msgid "%(account)s is an account for gifts or entertainment and at the same time a default expense account, so other expenses are booked on it (§ 4 (7) EStG)."
msgstr "%(account)s ist ein Konto für Geschenke oder Bewirtung und zugleich Standard-Aufwandskonto, auf dem deshalb auch andere Aufwendungen landen (§ 4 Abs. 7 EStG)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_statement_checker.py:0
msgid "%(accounts)s (%(category)s) has bookings in %(year)s: %(reason)s is outside the program scope of the module."
msgstr "%(accounts)s (%(category)s) hat Buchungen in %(year)s: %(reason)s liegt außerhalb des Programmumfangs des Moduls."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_event.py:0
msgid "%(action)s: %(type)s on %(date)s, amount %(amount).2f. %(reason)s"
msgstr "%(action)s: %(type)s am %(date)s, Betrag %(amount).2f. %(reason)s"

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(amount)s of %(move)s are booked on the bank suspense account (statement line not reconciled). Reconcile the statement line."
msgstr "%(amount)s aus %(move)s stehen auf dem Bank-Zwischenkonto (Auszugszeile nicht abgeglichen). Gleichen Sie die Auszugszeile ab."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(amount)s realised in %(year)s on %(account)s without EÜR category (%(move)s)."
msgstr "%(amount)s in %(year)s auf %(account)s ohne EÜR-Kategorie realisiert (%(move)s)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s changes the locked year %(year)s. Enter it as a correction of that year."
msgstr "%(asset)s ändert das gesperrte Jahr %(year)s. Erfassen Sie es als Berichtigung dieses Jahres."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_adjustment.py:0
msgid "%(asset)s does not belong to the business of the statement."
msgstr "%(asset)s gehört nicht zum Betrieb der Erklärung."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s has locked years and stays in the register."
msgstr "%(asset)s hat gesperrte Jahre und bleibt im Verzeichnis."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(asset)s is a vehicle used privately: enter the private use value as profit correction in Kz 106 (1 %% rule above 50 %% business use, otherwise the logbook or the private share of the costs), not as use withdrawal of the register."
msgstr "%(asset)s ist ein privat genutztes Kfz: Erfassen Sie den privaten Nutzungswert als Gewinnkorrektur in Kz 106 (1-%%-Regelung bei mehr als 50 %% betrieblicher Nutzung, sonst Fahrtenbuch oder privater Anteil der Kosten), nicht als Nutzungsentnahme des Verzeichnisses."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s is already in the register."
msgstr "%(asset)s steht bereits im Verzeichnis."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s is in the register and cannot be deleted (§ 4 (3) sentence 5 EStG). Record a disposal instead."
msgstr "%(asset)s steht im Verzeichnis und kann nicht gelöscht werden (§ 4 Abs. 3 S. 5 EStG). Erfassen Sie stattdessen einen Abgang."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s is in the register of its business and cannot move to another one. Record a disposal and a new asset."
msgstr "%(asset)s steht im Verzeichnis seines Betriebs und kann nicht in einen anderen wechseln. Erfassen Sie einen Abgang und ein neues Wirtschaftsgut."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s is not independently usable: no low-value asset and no asset pool (§ 6 (2) sentence 2 EStG)."
msgstr "%(asset)s ist nicht selbständig nutzungsfähig: kein GWG und kein Sammelposten (§ 6 Abs. 2 S. 2 EStG)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(asset)s is used for business by %(share).0f %% only: below 10 %% it is private property (R 4.2 (1) EStR)."
msgstr "%(asset)s wird nur zu %(share).0f %% betrieblich genutzt: unter 10 %% gehört es zum Privatvermögen (R 4.2 Abs. 1 EStR)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(asset)s is used privately: confirm the proposed use withdrawal of %(amount).2f (VAT %(vat).2f) or reject it with a reason (R-54)."
msgstr "%(asset)s wird privat mitgenutzt: Bestätigen Sie die vorgeschlagene Nutzungsentnahme von %(amount).2f (USt %(vat).2f) oder lehnen Sie sie mit Begründung ab (R-54)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(asset)s keeps the memo value %(value).2f of the previous system; by law the full cost is depreciated (R 7.4 (3) EStR)."
msgstr "%(asset)s behält den Erinnerungswert %(value).2f aus dem Vorsystem; rechtlich sind die vollen AK abzuschreiben (R 7.4 Abs. 3 EStR)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s was acquired privately within the last three years before the contribution: enter its total useful life, the private cost is reduced by the depreciation up to the contribution (§ 6 (1) no. 5 sentence 2 EStG)."
msgstr "%(asset)s wurde innerhalb der letzten drei Jahre vor der Einlage privat angeschafft: Geben Sie die Gesamtnutzungsdauer an, die privaten AK werden um die AfA bis zur Einlage gekürzt (§ 6 Abs. 1 Nr. 5 Satz 2 EStG)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(asset)s was used to earn other income before the contribution: the basis of the depreciation is reduced by the depreciation taken there (§ 7 (1) sentence 5 EStG). This case is outside the program scope."
msgstr "%(asset)s wurde vor der Einlage zur Erzielung anderer Einkünfte genutzt: Die AfA-Bemessungsgrundlage mindert sich um die dort vorgenommene AfA (§ 7 Abs. 1 Satz 5 EStG). Dieser Fall liegt außerhalb des Programmumfangs."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s: %(error)s"
msgstr "%(asset)s: %(error)s"

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s: VAT on a withdrawal only if input tax was deducted on the purchase and the business is not a small business (§ 3 (1b), § 19 UStG)."
msgstr "%(asset)s: USt auf eine Entnahme nur, wenn beim Erwerb Vorsteuer abgezogen wurde und der Betrieb kein Kleinunternehmer ist (§ 3 Abs. 1b, § 19 UStG)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s: a computer program above %(limit).2f is no trivial program (R 5.5 (1) sentence 3 EStR)."
msgstr "%(asset)s: Ein Computerprogramm über %(limit).2f ist kein Trivialprogramm (R 5.5 Abs. 1 Satz 3 EStR)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(asset)s: acquisition cost %(cost).2f (net cost and input tax that is not deductible), journal items of the purchase %(lines).2f. Correct the asset or the items."
msgstr "%(asset)s: Anschaffungskosten %(cost).2f (netto und nicht abziehbare Vorsteuer), Buchungszeilen des Zugangs %(lines).2f. Korrigieren Sie das Wirtschaftsgut oder die Buchungszeilen."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s: after a contribution the asset is depreciated over its remaining useful life (R 7.4 (10) EStR), which is shorter than the total useful life of %(total)s months (proposal: %(remaining)s months)."
msgstr "%(asset)s: Nach einer Einlage wird das Wirtschaftsgut über seine Restnutzungsdauer abgeschrieben (R 7.4 Abs. 10 EStR); sie ist kürzer als die Gesamtnutzungsdauer von %(total)s Monaten (Vorschlag: %(remaining)s Monate)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s: book value %(book).2f is not cost %(cost).2f less the depreciation up to the takeover %(acc).2f."
msgstr "%(asset)s: Buchwert %(book).2f ist nicht AK %(cost).2f abzüglich der AfA bis zur Übernahme %(acc).2f."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid ""
"%(asset)s: check the input tax correction under § 15a UStG.\n"
"%(help)s"
msgstr ""
"%(asset)s: Vorsteuerberichtigung nach § 15a UStG prüfen.\n"
"%(help)s"

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_event.py:0
msgid "%(asset)s: confirm that the profit of %(year)s, the business year before the acquisition or production, does not exceed the limit of § 7g (1) sentence 2 no. 1 EStG (§ 7g (6) no. 1 EStG)."
msgstr "%(asset)s: Bestätigen Sie, dass der Gewinn %(year)s, des Wirtschaftsjahres vor der Anschaffung oder Herstellung, die Gewinngrenze des § 7g Abs. 1 Satz 2 Nr. 1 EStG nicht überschreitet (§ 7g Abs. 6 Nr. 1 EStG)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s: degressive depreciation with %(rate)s %% is not allowed for a delivery on %(date)s (maximum %(max)s %%)."
msgstr "%(asset)s: Degressive AfA mit %(rate)s %% ist bei Lieferung am %(date)s nicht zulässig (höchstens %(max)s %%)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s: enter the date and kind of the disposal."
msgstr "%(asset)s: Erfassen Sie Datum und Art des Abgangs."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s: enter the date the proceeds were received; until then the asset stays in the register (§ 4 (3) sentence 4 EStG)."
msgstr "%(asset)s: Erfassen Sie den Tag, an dem der Erlös zugeflossen ist; bis dahin bleibt das Wirtschaftsgut im Verzeichnis (§ 4 Abs. 3 S. 4 EStG)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s: journal items of another business."
msgstr "%(asset)s: Buchungszeilen eines anderen Betriebs."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(asset)s: net cost %(cost).2f, journal items of the purchase %(lines).2f. Correct the asset or the items."
msgstr "%(asset)s: Netto-AK %(cost).2f, Buchungszeilen des Zugangs %(lines).2f. Korrigieren Sie das Wirtschaftsgut oder die Buchungszeilen."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(asset)s: no VAT status period on the delivery date %(date)s; the input tax is treated as %(treatment)s. Enter the VAT status periods of the business."
msgstr "%(asset)s: Kein USt-Statuszeitraum am Lieferdatum %(date)s; die Vorsteuer wird behandelt als: %(treatment)s. Erfassen Sie die USt-Statuszeiträume des Betriebs."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_event.py:0
msgid "%(asset)s: no special depreciation under § 7g (5) EStG: %(issues)s."
msgstr "%(asset)s: Keine Sonderabschreibung nach § 7g Abs. 5 EStG: %(issues)s."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s: on %(date)s the business is a small business; the input tax is not deductible and part of the cost (R 9b (1) EStR)."
msgstr "%(asset)s: Am %(date)s ist der Betrieb Kleinunternehmer; die Vorsteuer ist nicht abziehbar und gehört zu den Anschaffungskosten (R 9b Abs. 1 EStR)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s: only an asset taken over from another system may keep a memo value; new assets are depreciated in full (R 7.4 (3) EStR)."
msgstr "%(asset)s: Nur ein aus einem Vorsystem übernommenes Wirtschaftsgut darf einen Erinnerungswert behalten; neue Güter werden voll abgeschrieben (R 7.4 Abs. 3 EStR)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(asset)s: small business on %(date)s, but the input tax is treated as deductible; it is part of the cost (R 9b (1) EStR)."
msgstr "%(asset)s: Kleinunternehmer am %(date)s, die Vorsteuer wird aber als abziehbar behandelt; sie gehört zu den Anschaffungskosten (R 9b Abs. 1 EStR)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(asset)s: subsidy approved in %(year)s, before the year of delivery. A subsidy before the acquisition (R 6.5 (4) EStR) is outside the program scope."
msgstr "%(asset)s: Zuschuss %(year)s bewilligt, vor dem Lieferjahr. Ein Zuschuss vor der Anschaffung (R 6.5 Abs. 4 EStR) liegt außerhalb des Programmumfangs."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s: the asset register belongs to the business (its main company or a branch that is a business of its own)."
msgstr "%(asset)s: Das Anlagenverzeichnis gehört zum Betrieb (seiner Hauptfirma oder einer Filiale, die ein eigener Betrieb ist)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s: the book value at the takeover %(book).2f must be between 0 and the cost %(cost).2f."
msgstr "%(asset)s: Der Buchwert bei Übernahme %(book).2f muss zwischen 0 und den AK %(cost).2f liegen."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s: the change alters the values of the locked year %(year)s. Record it as a correction of that year."
msgstr "%(asset)s: Die Änderung ändert die Werte des gesperrten Jahres %(year)s. Erfassen Sie sie als Berichtigung dieses Jahres."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(asset)s: the depreciation over the useful life does not add up to the cost less reductions."
msgstr "%(asset)s: Die AfA über die Nutzungsdauer ergibt nicht die AK abzüglich Minderungen."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(asset)s: the journal items %(moves)s of the purchase are not posted (cancelled or reset to draft)."
msgstr "%(asset)s: Die Buchungszeilen %(moves)s des Zugangs sind nicht gebucht (storniert oder auf Entwurf zurückgesetzt)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s: the memo value exceeds the book value at the takeover."
msgstr "%(asset)s: Der Erinnerungswert übersteigt den Buchwert bei Übernahme."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s: the net value %(value).2f is outside the limits of this kind (above %(lower).2f up to %(upper).2f)."
msgstr "%(asset)s: Der Nettowert %(value).2f liegt außerhalb der Grenzen dieser Art (über %(lower).2f bis %(upper).2f)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(asset)s: the proceeds were received on %(paid)s (payment of %(invoice)s), the register expenses the cost on %(receipt)s."
msgstr "%(asset)s: Der Erlös ist am %(paid)s zugeflossen (Zahlung zu %(invoice)s), das Verzeichnis setzt die Anschaffungskosten am %(receipt)s als Betriebsausgabe an."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(asset)s: the reduction under § 7g (2) sentence 3 EStG (investment deduction) is outside the program scope."
msgstr "%(asset)s: Die Herabsetzung nach § 7g Abs. 2 S. 3 EStG (Investitionsabzugsbetrag) liegt außerhalb des Programmumfangs."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(asset)s: the sales invoice is paid in instalments or only in part. The cost of an asset under § 4 (3) sentence 4 EStG is then an expense in the amount of each payment (R 4.5 (5) EStR); this is outside the program scope."
msgstr "%(asset)s: Die Ausgangsrechnung wird in Raten oder nur teilweise bezahlt. Die Anschaffungskosten eines Wirtschaftsguts nach § 4 Abs. 3 Satz 4 EStG sind dann in Höhe der jeweiligen Zahlung Betriebsausgabe (R 4.5 Abs. 5 EStR); das liegt außerhalb des Programmumfangs."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(asset)s: the special depreciation under § 7g (5) EStG is not allowed: %(issues)s. Remove it; if its year is finalised, correct that statement (§ 7g (4) EStG)."
msgstr "%(asset)s: Die Sonderabschreibung nach § 7g Abs. 5 EStG ist nicht zulässig: %(issues)s. Entfernen Sie sie; ist ihr Jahr festgeschrieben, berichtigen Sie diese Erklärung (§ 7g Abs. 4 EStG)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s: the year %(year)s is locked; %(field)s cannot change. Record it as a correction."
msgstr "%(asset)s: Das Jahr %(year)s ist gesperrt; %(field)s kann sich nicht mehr ändern. Erfassen Sie die Änderung als Berichtigung."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(asset)s: there are no rule parameters of degressive depreciation for a delivery on %(date)s, so the rate cannot be checked. If the previous system already depreciates linearly, enter the year of the switch; otherwise add the rule parameters of that time."
msgstr "%(asset)s: Für eine Lieferung am %(date)s gibt es keine Regelparameter der degressiven AfA, der Satz kann daher nicht geprüft werden. Schreibt das Vorsystem bereits linear ab, geben Sie das Jahr des Wechsels an; sonst ergänzen Sie die Regelparameter dieser Zeit."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(assets)s share journal items of the purchase: cost together %(cost).2f, journal items %(lines).2f. Correct the assets or the items (the cost must not count twice)."
msgstr "%(assets)s teilen sich Buchungszeilen des Zugangs: Anschaffungskosten zusammen %(cost).2f, Buchungszeilen %(lines).2f. Korrigieren Sie die Wirtschaftsgüter oder die Buchungszeilen (die Anschaffungskosten dürfen nicht doppelt zählen)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_residual_classification.py:0
msgid "%(category)s does not fit the classification %(kind)s."
msgstr "%(category)s passt nicht zur Klassifikation %(kind)s."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_category.py:0
msgid "%(category)s is not business income."
msgstr "%(category)s ist keine Betriebseinnahme."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_category.py:0
msgid "%(category)s: only business income has a revenue type, and business income needs one."
msgstr "%(category)s: Nur Betriebseinnahmen haben eine Erlösart, und Betriebseinnahmen brauchen eine."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_category.py:0
msgid "%(category)s: only tax categories have a VAT kind."
msgstr "%(category)s: Nur Steuerkategorien haben eine Umsatzsteuerart."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_form.py:0
msgid "%(code)s %(name)s is negative (%(amount)s), but the official form allows no minus in this field."
msgstr "%(code)s %(name)s ist negativ (%(amount)s), der amtliche Vordruck lässt in diesem Feld aber kein Minus zu."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_form.py:0
msgid "%(code)s %(name)s is outside the program scope of the module and has a value of %(amount)s."
msgstr "%(code)s %(name)s liegt außerhalb des Programmumfangs des Moduls und hat einen Wert von %(amount)s."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_check.py:0
msgid "%(code)s is already acknowledged."
msgstr "%(code)s ist bereits quittiert."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(code)s: %(moves)s"
msgstr "%(code)s: %(moves)s"

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(code)s: bookings on depreciation accounts %(ledger).2f, asset register %(register).2f. The form uses the register; correct the ledger or the register."
msgstr "%(code)s: Buchungen auf AfA-Konten %(ledger).2f, Anlagenverzeichnis %(register).2f. Das Formular verwendet das Verzeichnis; korrigieren Sie das Hauptbuch oder das Verzeichnis."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_field.py:0
msgid "%(code)s: only an existing ELSTER field ID can be verified."
msgstr "%(code)s: Nur eine vorhandene ELSTER-Feldkennung kann als geprüft markiert werden."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_field.py:0
msgid "%(codes)s cannot be deleted; it is used by %(users)s."
msgstr "%(codes)s kann nicht gelöscht werden, weil es von %(users)s verwendet wird."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_statement_checker.py:0
msgid "%(companies)s: neither the global lock date nor the hard lock date covers 31 December %(year)s. Set the global lock date before finalising the statement."
msgstr "%(companies)s: Weder das globale noch das endgültige Sperrdatum reicht bis zum 31.12.%(year)s. Setzen Sie vor der Festschreibung das globale Sperrdatum."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_statement_checker.py:0
msgid "%(companies)s: only the hard lock date covers 31 December %(year)s. December lines posted late are moved to the next year without exception; the global lock date is recommended."
msgstr "%(companies)s: Nur das endgültige Sperrdatum reicht bis zum 31.12.%(year)s. Nachträglich gebuchte Dezember-Zeilen werden ohne Ausnahmemöglichkeit ins Folgejahr verschoben; empfohlen ist das globale Sperrdatum."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/wizards/setup_wizard.py:0
msgid "%(company)s has a VAT status period from %(date)s on already; change the periods under Configuration › EÜR › VAT Status Periods."
msgstr "%(company)s hat bereits einen umsatzsteuerlichen Statuszeitraum ab %(date)s; ändern Sie die Zeiträume unter Konfiguration › EÜR › Umsatzsteuerliche Statuszeiträume."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_statement_checker.py:0
msgid "%(company)s has income from agriculture and forestry (Kz 103 = 1): Anlage LuF is outside the program scope."
msgstr "%(company)s hat Einkünfte aus Land- und Forstwirtschaft (Kz 103 = 1): Die Anlage LuF liegt außerhalb des Programmumfangs."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/wizards/setup_wizard.py:0
msgid "%(company)s has no VAT status period: create one with the wizard, otherwise every year is computed as standard taxation."
msgstr "%(company)s hat keinen umsatzsteuerlichen Statuszeitraum: Legen Sie einen mit dem Assistenten an, sonst wird jedes Jahr als Regelbesteuerung berechnet."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_statement.py:0
msgid "%(company)s is a branch of a business: create the statement for the main company or a branch that is a business of its own."
msgstr "%(company)s ist eine Filiale eines Betriebs: Legen Sie die Erklärung für die Hauptfirma oder eine Filiale an, die ein eigener Betrieb ist."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(count)s addition(s) on %(account)s without entry in the asset register; create the asset from the journal item."
msgstr "%(count)s Zugang/Zugänge auf %(account)s ohne Eintrag im Anlagenverzeichnis; legen Sie das Wirtschaftsgut aus der Buchungszeile an."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(count)s bank statement lines of %(year)s older than 10 days are not reconciled."
msgstr "%(count)s Kontoauszugszeilen aus %(year)s, älter als 10 Tage, sind nicht abgeglichen."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(count)s documents with income or expense in %(year)s have no file attached: %(moves)s."
msgstr "%(count)s Belege mit Einnahmen oder Ausgaben in %(year)s haben keine Datei: %(moves)s."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(count)s draft entries dated in %(year)s are ignored: %(moves)s. Post or delete them."
msgstr "%(count)s Entwürfe mit Datum in %(year)s werden nicht berücksichtigt: %(moves)s. Buchen oder löschen Sie sie."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(count)s lines with income or expense in %(year)s have neither partner nor text."
msgstr "%(count)s Zeilen mit Einnahmen oder Ausgaben in %(year)s haben weder Partner noch Text."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/wizards/opening_wizard.py:0
msgid "%(count)s open items have no category yet: their payments are blocked (C-35)."
msgstr "%(count)s offene Posten haben noch keine Kategorie: Ihre Zahlungen sind gesperrt (C-35)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(count)s reconciliations with draft entries are ignored: %(moves)s."
msgstr "%(count)s Ausgleiche mit Entwürfen werden nicht berücksichtigt: %(moves)s."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/wizards/opening_wizard.py:0
msgid "%(created)s open items taken over, %(updated)s updated."
msgstr "%(created)s offene Posten übernommen, %(updated)s aktualisiert."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(error)s The asset cannot be entered in Anlage AVEÜR."
msgstr "%(error)s Das Wirtschaftsgut kann nicht in die Anlage AVEÜR übernommen werden."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset.py:0
msgid "%(fields)s are calculated by the asset register."
msgstr "%(fields)s berechnet das Anlagenverzeichnis."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(group)s: the book value at the end of %(prev)s (%(end).2f) differs from the book value at the beginning of %(year)s (%(start).2f)."
msgstr "%(group)s: Der Buchwert am Ende von %(prev)s (%(end).2f) weicht vom Buchwert zu Beginn von %(year)s (%(start).2f) ab."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_adjustment.py:0
msgid "%(input)s must not be negative."
msgstr "%(input)s darf nicht negativ sein."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_cash_balance.py:0
msgid "%(journal)s does not belong to the business of the statement."
msgstr "%(journal)s gehört nicht zum Betrieb der Erklärung."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_opening_item.py:0
#: code:addons/l10n_de_euer/models/euer_residual_classification.py:0
msgid "%(line)s does not belong to the business %(company)s."
msgstr "%(line)s gehört nicht zum Betrieb %(company)s."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_gift_line.py:0
msgid "%(line)s is not a line of %(move)s."
msgstr "%(line)s ist keine Zeile von %(move)s."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_opening_item.py:0
msgid "%(line)s is not an open item (receivable, payable or reconcilable balance sheet account)."
msgstr "%(line)s ist kein offener Posten (Forderung, Verbindlichkeit oder abstimmbares Bilanzkonto)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(line)s is reconciled with a journal item of another business (a company of the same main company with its own EÜR). Money and document belong to different statements; correct the reconciliation."
msgstr "%(line)s ist mit einer Buchungszeile eines anderen Betriebs ausgeglichen (einer Firma derselben Hauptfirma mit eigener EÜR). Geld und Beleg gehören zu verschiedenen Erklärungen; korrigieren Sie den Ausgleich."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(move)s contains a line realised on booking (%(line)s) together with open items. Book it as an entry without open item."
msgstr "%(move)s enthält eine Zeile, die zum Buchungsdatum realisiert wird (%(line)s), zusammen mit offenen Posten. Erfassen Sie sie als eigene Buchung ohne offenen Posten."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(move)s has neither money nor open items, and no realisation rule applies (e.g. expense against a non-reconcilable liability, provision, accrual). Make the liability reconcilable and book the invoice as document, or use a category for income or expense on payment."
msgstr "%(move)s hat weder Geld noch offene Posten, und keine Realisierungsregel greift (z. B. Aufwand gegen nicht abstimmbare Verbindlichkeit, Rückstellung, Abgrenzung). Setzen Sie die Verbindlichkeit abstimmbar und erfassen Sie die Rechnung als Beleg, oder verwenden Sie eine Kategorie „BE/BA bei Zahlung“."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_opening_item.py:0
msgid "%(move)s is no opening entry (opening move of the company or entry with an opening balance account)."
msgstr "%(move)s ist keine Eröffnungsbuchung (Eröffnungsbuchung der Firma oder Buchung mit einem Saldenvortragskonto)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(move)s is not realised on its booking date: the payment of the balance sheet account realises the income or expense (5.5.1 b)."
msgstr "%(move)s wird nicht zum Buchungsdatum realisiert: Die Zahlung des Bilanzkontos realisiert die Einnahme oder Ausgabe (5.5.1 b)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(move)s is realised by its payment, but the payment reaches other form fields (%(payment)s) than its income or expense lines (%(fields)s)."
msgstr "%(move)s wird mit der Zahlung realisiert, die Zahlung erreicht aber andere Formularfelder (%(payment)s) als die Ertrags- oder Aufwandszeilen (%(fields)s)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(move)s leaves an unallocated rest of %(amount)s on %(account)s (advance payment or payment before the invoice). Classify the rest or reconcile it with the invoice."
msgstr "%(move)s hinterlässt einen nicht zugeordneten Rest von %(amount)s auf %(account)s (Anzahlung oder Zahlung vor der Rechnung). Klassifizieren Sie den Rest oder gleichen Sie ihn mit der Rechnung aus."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(move)s leaves an unallocated rest of %(amount)s on %(account)s (money returned: refund or repayment without document). Classify the rest or reconcile it with the credit note."
msgstr "%(move)s hinterlässt einen nicht zugeordneten Rest von %(amount)s auf %(account)s (zurückgezahltes Geld: Erstattung oder Rückzahlung ohne Beleg). Klassifizieren Sie den Rest oder gleichen Sie ihn mit der Gutschrift aus."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(move)s leaves an unallocated rest of %(amount)s on %(account)s that another rest of the same partner cancels in the same year (payment and its return). Reconcile the two payments in Odoo."
msgstr "%(move)s hinterlässt einen nicht zugeordneten Rest von %(amount)s auf %(account)s, den ein anderer Rest desselben Partners im selben Jahr aufhebt (Zahlung und Rückzahlung). Gleichen Sie die beiden Zahlungen in Odoo miteinander ab."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(move)s leaves an unallocated rest of %(amount)s on %(account)s."
msgstr "%(move)s hinterlässt einen nicht zugeordneten Rest von %(amount)s auf %(account)s."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(move)s leaves an unallocated rest of %(amount)s on the outstanding account %(account)s: the payment it was reconciled with is missing (e.g. reversed after the bank reconciliation). Reconcile the statement line again or classify the rest."
msgstr "%(move)s hinterlässt einen nicht zugeordneten Rest von %(amount)s auf dem Konto für ausstehende Zahlungen %(account)s: Die Zahlung, mit der er abgestimmt war, fehlt (z. B. nach dem Bankabgleich storniert). Stimmen Sie die Auszugszeile erneut ab oder klassifizieren Sie den Rest."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(moves)s is a candidate for the ten-day rule (%(reasons)s). Decide it in the review list of the turn of the year."
msgstr "%(moves)s ist ein Kandidat der 10-Tage-Regel (%(reasons)s). Entscheiden Sie ihn in der Prüfliste zum Jahreswechsel."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(moves)s were reconciled on %(date)s, after the end of %(year)s; the values of %(year)s changed. If the year was already filed, correct it."
msgstr "%(moves)s wurden am %(date)s abgestimmt, nach dem Ende von %(year)s; die Werte von %(year)s haben sich geändert. Wurde das Jahr schon erklärt, berichtigen Sie es."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(moves)s: a journal entry with a private line settles a document without money; the withdrawal or contribution and the income or expense would be lost. Book the private payment as an entry that settles the document completely (private account against the open item, discount next to it)."
msgstr "%(moves)s: Ein Buchungssatz mit Privatzeile gleicht einen Beleg ohne Geld aus; Entnahme bzw. Einlage und Betriebseinnahme bzw. -ausgabe gingen verloren. Buchen Sie die private Zahlung als Buchungssatz, der den Beleg vollständig ausgleicht (Privatkonto gegen den offenen Posten, Skonto daneben)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_calculation_checker.py:0
msgid "%(moves)s: money is returned over a receivable or payable between two years (returned direct debit or refund). Classify the money entry."
msgstr "%(moves)s: Geld fließt über ein Debitoren- oder Kreditorenkonto zwischen zwei Jahren zurück (Rücklastschrift oder Rückzahlung). Klassifizieren Sie die Geldbuchung."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_statement_final.py:0
msgid "%(name)s (position %(index)s): the chain hash does not follow from the previous hash and the payload hash."
msgstr "%(name)s (Position %(index)s): Der Ketten-Hash folgt nicht aus dem vorherigen Hash und dem Payload-Hash."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_statement_final.py:0
msgid "%(name)s (position %(index)s): the previous hash is not the chain hash of the finalisation before."
msgstr "%(name)s (Position %(index)s): Der vorherige Hash ist nicht der Ketten-Hash der vorigen Festschreibung."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_statement_final.py:0
msgid "%(name)s (position %(index)s): the stored payload is missing."
msgstr "%(name)s (Position %(index)s): Der gespeicherte Payload fehlt."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_statement_final.py:0
msgid "%(name)s (position %(index)s): the stored payload was changed, its hash differs from the hash of the finalisation."
msgstr "%(name)s (Position %(index)s): Der gespeicherte Payload wurde geändert, sein Hash weicht vom Hash der Festschreibung ab."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_form.py:0
msgid "%(name)s can only be set to verified with the name, role and date of the person who verified it."
msgstr "%(name)s kann nur mit Name, Rolle und Datum der prüfenden Person als geprüft markiert werden."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_form.py:0
msgid "%(name)s can only be superseded by a newer version of the same form and year."
msgstr "%(name)s kann nur durch eine neuere Version desselben Formulars und Jahres ersetzt werden."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_statement_final.py:0
msgid ""
"%(name)s cannot be finalised:\n"
"%(issues)s"
msgstr ""
"%(name)s kann nicht festgeschrieben werden:\n"
"%(issues)s"

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_statement_final.py:0
msgid "%(name)s cannot be finalised: compute and check it first."
msgstr "%(name)s kann nicht festgeschrieben werden: Berechnen und prüfen Sie die Erklärung zuerst."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/ir_attachment.py:0
msgid "%(names)s belongs to a finalised EÜR statement and cannot be changed or deleted."
msgstr "%(names)s gehört zu einer festgeschriebenen EÜR-Erklärung und kann weder geändert noch gelöscht werden."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_statement.py:0
msgid "%(names)s is finalised and cannot be changed; create a correction."
msgstr "%(names)s ist festgeschrieben und kann nicht geändert werden; legen Sie eine Berichtigung an."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_statement.py:0
msgid "%(names)s is finalised and cannot be deleted; keep it for at least 10 years (§ 147 (3) AO)."
msgstr "%(names)s ist festgeschrieben und kann nicht gelöscht werden; bewahren Sie die Erklärung mindestens 10 Jahre auf (§ 147 Abs. 3 AO)."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_move_info.py:0
msgid "%(period)s is not a VAT return period; use e.g. 2026-12, 2026-Q4 or 2026."
msgstr "%(period)s ist kein Voranmeldungszeitraum; verwenden Sie z. B. 2026-12, 2026-Q4 oder 2026."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_pool.py:0
msgid "%(pool)s holds assets and cannot be deleted."
msgstr "%(pool)s enthält Wirtschaftsgüter und kann nicht gelöscht werden."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_pool.py:0
msgid "%(pool)s is locked and cannot change."
msgstr "%(pool)s ist gesperrt und kann sich nicht mehr ändern."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(year)s has an asset pool and low-value assets above 250 € net. The choice applies to all additions of the year (§ 6 (2a) sentence 5 EStG): in a pool year low-value assets are allowed up to 250 € only."
msgstr "%(year)s enthält einen Sammelposten und GWG über 250 € netto. Das Wahlrecht gilt einheitlich für alle Zugänge des Jahres (§ 6 Abs. 2a S. 5 EStG): Im Sammelposten-Jahr sind GWG nur bis 250 € zulässig."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_asset_checker.py:0
msgid "%(year)s has an asset pool: every movable, independently usable asset above 250 € up to 1,000 € net of the year goes into the pool (§ 6 (2a) sentence 5 EStG), also %(assets)s."
msgstr "%(year)s hat einen Sammelposten: Jedes bewegliche, selbständig nutzbare Wirtschaftsgut des Jahres über 250 € bis 1.000 € netto gehört in den Sammelposten (§ 6 Abs. 2a Satz 5 EStG), auch %(assets)s."

#. module: l10n_de_euer
#: model:ir.actions.report,print_report_name:l10n_de_euer.action_report_check_protocol
msgid "'EUER_check_protocol_%s_v%s' % (object.year, object.version)"
msgstr "'EUER_Pruefprotokoll_%s_v%s' % (object.year, object.version)"

#. module: l10n_de_euer
#: model:ir.actions.report,print_report_name:l10n_de_euer.action_report_evidence
msgid "'EUER_evidence_%s_v%s' % (object.year, object.version)"
msgstr "'EUER_Belegnachweis_%s_v%s' % (object.year, object.version)"

#. module: l10n_de_euer
#: model:ir.actions.report,print_report_name:l10n_de_euer.action_report_fill_aid
msgid "'EUER_fill_in_aid_%s_v%s' % (object.year, object.version)"
