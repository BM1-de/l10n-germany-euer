msgstr "Die Buchung ist Beleg des Wirtschaftsguts %(asset)s im EÜR-Anlagenverzeichnis und kann nicht gelöscht werden."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_category.py:0
msgid "The field %(field)s does not belong to %(form)s."
msgstr "Das Feld %(field)s gehört nicht zu %(form)s."

#. module: l10n_de_euer
#. odoo-python
#: code:addons/l10n_de_euer/models/euer_category.py:0
msgid "The field %(field)s is not a field of %(year)s."
msgstr "Das Feld %(field)s ist kein Feld des Jahres %(year)s."

#. module: l10n_de_euer
#: model:ir.model.fields,help:l10n_de_euer.field_l10n_de_euer_field__mandatory
