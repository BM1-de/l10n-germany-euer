<odoo>
    <record id="l10n_de_euer_account_review_view_form" model="ir.ui.view">
        <field name="name">l10n_de_euer.account.review.form</field>
        <field name="model">l10n_de_euer.account.review</field>
        <field name="arch" type="xml">
            <form>
                <p>
                    Lists all accounts with posted lines in the year with their EÜR
                    category, confidence, confirmation and proposal.
                </p>
                <group>
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="year" options="{'enable_formatting': false}" />
                </group>
                <footer>
                    <button
                        name="action_review"
                        type="object"
                        string="Show Accounts"
                        class="btn-primary"
                    />
                    <button
                        name="action_run_checks"
                        type="object"
                        string="Run Checks"
                        class="btn-secondary"
                        groups="account.group_account_user,account.group_account_manager"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_de_euer_account_review" model="ir.actions.act_window">
        <field name="name">Check Account Assignment</field>
        <field name="res_model">l10n_de_euer.account.review</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="l10n_de_euer_account_review_line_view_list" model="ir.ui.view">
        <field name="name">l10n_de_euer.account.review.line.list</field>
        <field name="model">l10n_de_euer.account.review.line</field>
        <field name="arch" type="xml">
            <list
                create="0"
                delete="0"
                decoration-danger="unassigned or needs_confirmation"
                decoration-warning="warn_used"
            >
                <header>
                    <button
                        name="action_apply_proposal"
                        type="object"
                        string="Apply Proposal"
                        groups="account.group_account_manager"
                    />
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm"
                        groups="account.group_account_manager"
                    />
                </header>
                <field name="account_code" width="70px" />
                <field name="account_id" />
                <field name="account_type" optional="hide" />
                <field name="category_id" />
                <field name="role" optional="show" />
                <field name="confidence" />
                <field name="confirmed" />
                <field name="proposal_id" />
                <field name="line_count" optional="show" />
                <field name="debit" optional="hide" />
                <field name="credit" optional="hide" />
                <field name="balance" />
                <field name="currency_id" column_invisible="True" />
                <field name="unassigned" column_invisible="True" />
                <field name="needs_confirmation" column_invisible="True" />
                <field name="warn_used" column_invisible="True" />
                <button
                    name="action_open_move_lines"
                    type="object"
                    icon="fa-list"
                    title="Journal items"
                />
                <button
                    name="action_open_assignment"
                    type="object"
                    icon="fa-link"
                    title="Assignments"
                />
            </list>
        </field>
    </record>

    <record id="l10n_de_euer_account_review_line_view_search" model="ir.ui.view">
        <field name="name">l10n_de_euer.account.review.line.search</field>
        <field name="model">l10n_de_euer.account.review.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="account_id" />
                <field name="category_id" />
                <filter
                    name="filter_unassigned"
                    string="Not Assigned"
                    domain="[('unassigned', '=', True)]"
                />
                <filter
                    name="filter_needs_confirmation"
                    string="Low Confidence, Unconfirmed"
                    domain="[('needs_confirmation', '=', True)]"
                />
                <filter
                    name="filter_warn_used"
                    string="Not Provided For, Used"
                    domain="[('warn_used', '=', True)]"
                />
                <group>
                    <filter
                        name="group_category"
                        string="Category"
                        context="{'group_by': 'category_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_de_euer_account_review_line" model="ir.actions.act_window">
        <field name="name">Account Assignment Review</field>
        <field name="res_model">l10n_de_euer.account.review.line</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
