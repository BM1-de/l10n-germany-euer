<odoo>
    <record id="l10n_de_euer_asset_from_move_line_view_form" model="ir.ui.view">
        <field name="name">l10n_de_euer.asset.from.move.line.form</field>
        <field name="model">l10n_de_euer.asset.from.move.line</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">
                    Proposals from the journal items: delivery date from the date
                    of supply of the document, group from the account. Check them
                    before you enter the asset in the register.
                </p>
                <group>
                    <group>
                        <field name="mode" widget="radio" />
                        <field name="name" invisible="mode != 'single'" />
                        <field name="delivery_date" />
                        <field name="asset_kind" />
                        <field name="aveuer_group" />
                    </group>
                    <group>
                        <field name="currency_id" invisible="1" />
                        <field name="company_id" invisible="1" />
                        <field name="gross_split" invisible="1" />
                        <field
                            name="vat_shown"
                            invisible="not gross_split"
                            required="gross_split"
                        />
                        <field name="vat_rate" invisible="1" />
                        <field name="cost_net" invisible="mode != 'single'" />
                        <field name="input_tax" invisible="mode != 'single'" />
                        <field name="method" invisible="asset_kind != 'depreciable'" />
                        <field
                            name="useful_life_months"
                            invisible="asset_kind != 'depreciable'"
                        />
                    </group>
                </group>
                <field name="move_line_ids">
                    <list>
                        <field name="date" />
                        <field name="move_id" />
                        <field name="account_id" />
                        <field name="name" />
                        <field name="balance" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_create"
                        type="object"
                        string="Create Asset"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_de_euer_asset_from_move_line" model="ir.actions.act_window">
        <field name="name">Create EÜR Asset</field>
        <field name="res_model">l10n_de_euer.asset.from.move.line</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move_line" />
        <field name="binding_view_types">list</field>
        <field
            name="group_ids"
            eval="[(4, ref('account.group_account_user')), (4, ref('account.group_account_manager'))]"
        />
    </record>

    <record id="l10n_de_euer_asset_import_view_form" model="ir.ui.view">
        <field name="name">l10n_de_euer.asset.import.form</field>
        <field name="model">l10n_de_euer.asset.import</field>
        <field name="arch" type="xml">
            <form>
                <field name="state" invisible="1" />
                <div invisible="state != 'upload'">
                    <p>
                        CSV with a header row, separated by semicolons. Columns:
                        Bezeichnung, Inventarnummer, Gruppe, Art, Lieferdatum, AK,
                        AK netto, VSt-Status, ND (Monate), Methode, Satz, Wechsel
                        zu linear (Jahr), kumulierte AfA bis Stichtag,
                        Restbuchwert, Erinnerungswert, Sammelposten-Jahrgang,
                        Sammelposten-Restbetrag, Sonder-AfA § 7g, Jahr Sonder-AfA
                        § 7g. Amounts in German (1.234,56) or technical notation
                        (1234.56).
                    </p>
                    <p class="text-muted">
                        The years up to the takeover date stay as filed: the
                        register continues from the book value at that date. A
                        row whose book value is not cost less accumulated
                        depreciation is an error.
                    </p>
                </div>
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="opening_date" readonly="state != 'upload'" />
                    </group>
                    <group>
                        <field
                            name="file"
                            filename="filename"
                            readonly="state != 'upload'"
                        />
                        <field name="filename" invisible="1" />
                        <field name="error_count" invisible="state == 'upload'" />
                    </group>
                </group>
                <field name="line_ids" invisible="state == 'upload'" readonly="1">
                    <list decoration-danger="error">
                        <field name="sequence" />
                        <field name="name" />
                        <field name="aveuer_group" />
                        <field name="asset_kind" />
                        <field name="delivery_date" />
                        <field name="cost" />
                        <field name="accumulated" />
                        <field name="book_value" />
                        <field name="method" optional="show" />
                        <field
                            name="switch_to_linear_year"
                            optional="show"
                            options="{'enable_formatting': false}"
                        />
                        <field name="memo_value" optional="hide" />
                        <field
                            name="pool_year"
                            optional="hide"
                            options="{'enable_formatting': false}"
                        />
                        <field name="pool_remaining" optional="hide" />
                        <field name="sec7g_special" optional="hide" />
                        <field
                            name="sec7g_year"
                            optional="hide"
                            options="{'enable_formatting': false}"
                        />
                        <field name="error" />
                        <field name="warning" optional="show" />
                        <field name="currency_id" column_invisible="True" />
                    </list>
                </field>
                <separator string="Filed AVEÜR (optional)" />
                <p class="text-muted">
                    Book values at the end of the takeover year per group, as
                    filed with the previous system. The checks of the following
                    year compare the register with them.
                </p>
                <field name="total_ids" readonly="state == 'done'">
                    <list editable="bottom">
                        <field name="aveuer_group" />
                        <field name="book_value_end" sum="Total" />
                        <field name="currency_id" column_invisible="True" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_parse"
                        type="object"
                        string="Read File"
                        class="btn-primary"
                        invisible="state != 'upload'"
                    />
                    <button
                        name="action_import"
                        type="object"
                        string="Import"
                        class="btn-primary"
                        invisible="state != 'preview' or error_count"
                    />
                    <button special="cancel" string="Close" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_de_euer_asset_import" model="ir.actions.act_window">
        <field name="name">Take Over Asset Register</field>
        <field name="res_model">l10n_de_euer.asset.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="l10n_de_euer_asset_check_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_de_euer.asset.check.wizard.form</field>
        <field name="model">l10n_de_euer.asset.check.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="year" options="{'enable_formatting': false}" />
                </group>
                <footer>
                    <button
                        name="action_run"
                        type="object"
                        string="Check"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_de_euer_asset_check_wizard" model="ir.actions.act_window">
        <field name="name">Check Asset Register</field>
        <field name="res_model">l10n_de_euer.asset.check.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
