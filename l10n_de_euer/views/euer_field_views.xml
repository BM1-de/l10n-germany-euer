<odoo>
    <record id="l10n_de_euer_field_view_list" model="ir.ui.view">
        <field name="name">l10n_de_euer.field.list</field>
        <field name="model">l10n_de_euer.field</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" column_invisible="1" />
                <field name="form_id" />
                <field name="line" />
                <field name="box" />
                <field name="kz" />
                <field name="code" />
                <field name="name" />
                <field name="official_label" optional="hide" />
                <field name="field_type" />
                <field name="sign" />
                <field name="formula" optional="show" />
                <field name="allow_negative" optional="hide" />
                <field name="relative_year" optional="hide" />
                <field
                    name="scope_status"
                    widget="badge"
                    decoration-success="scope_status == 'supported'"
                    decoration-info="scope_status == 'manual'"
                    decoration-warning="scope_status == 'blocked'"
                />
            </list>
        </field>
    </record>

    <record id="l10n_de_euer_field_view_form" model="ir.ui.view">
        <field name="name">l10n_de_euer.field.form</field>
        <field name="model">l10n_de_euer.field</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="code" />
                        </h1>
                        <h2>
                            <field name="name" />
                        </h2>
                    </div>
                    <group>
                        <group name="position" string="Position">
                            <field name="form_id" />
                            <field name="box" />
                            <field name="kz" />
                            <field name="line" />
                            <field name="sequence" />
                        </group>
                        <group name="calculation" string="Calculation">
                            <field name="field_type" />
                            <field name="sign" />
                            <field name="formula" />
                            <field name="allow_negative" />
                            <field name="relative_year" />
                            <field name="mandatory" />
                            <field name="scope_status" />
                        </group>
                    </group>
                    <group name="label" string="Official Wording">
                        <field name="official_label" nolabel="1" colspan="2" />
                    </group>
                    <group name="elster" string="ELSTER">
                        <field name="elster_field_id" />
                        <field name="elster_xpath" />
                        <field name="elster_verified" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_de_euer_field_view_search" model="ir.ui.view">
        <field name="name">l10n_de_euer.field.search</field>
        <field name="model">l10n_de_euer.field</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="name" />
                <field name="kz" />
                <field name="official_label" />
                <field name="form_id" />
                <field name="year" />
                <filter
                    name="filter_euer"
                    string="Anlage EÜR"
                    domain="[('form_type', '=', 'euer')]"
                />
                <filter
                    name="filter_aveuer"
                    string="Anlage AVEÜR"
                    domain="[('form_type', '=', 'aveuer')]"
                />
                <filter
                    name="filter_sz"
                    string="Anlage SZ"
                    domain="[('form_type', '=', 'sz')]"
                />
                <separator />
                <filter
                    name="filter_computed"
                    string="Computed by Formula"
                    domain="[('formula', '!=', False)]"
                />
                <filter
                    name="filter_negative"
                    string="Negative Allowed"
                    domain="[('allow_negative', '=', True)]"
                />
                <separator />
                <filter
                    name="filter_supported"
                    string="Supported"
                    domain="[('scope_status', '=', 'supported')]"
                />
                <filter
                    name="filter_manual"
                    string="Manual Input"
                    domain="[('scope_status', '=', 'manual')]"
                />
                <filter
                    name="filter_blocked"
                    string="Not Supported"
                    domain="[('scope_status', '=', 'blocked')]"
                />
                <group>
                    <filter
                        name="group_form"
                        string="Form Year"
                        context="{'group_by': 'form_id'}"
                    />
                    <filter
                        name="group_box"
                        string="Box"
                        context="{'group_by': 'box'}"
                    />
                    <filter
                        name="group_scope"
                        string="Program Scope"
                        context="{'group_by': 'scope_status'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_de_euer_field" model="ir.actions.act_window">
        <field name="name">Form Fields</field>
        <field name="res_model">l10n_de_euer.field</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_form': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No form fields</p>
            <p>
                Every line of the official forms with its stable code, Kennzahl,
                official wording and formula.
            </p>
        </field>
    </record>
</odoo>
