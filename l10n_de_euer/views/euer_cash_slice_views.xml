<odoo>
    <record id="l10n_de_euer_cash_slice_view_list" model="ir.ui.view">
        <field name="name">l10n_de_euer.cash.slice.list</field>
        <field name="model">l10n_de_euer.cash.slice</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date" />
                <field name="attribution_year" options="{'enable_formatting': false}" />
                <field name="field_code" />
                <field name="kz" optional="show" />
                <field name="kind" optional="show" />
                <field name="source_move_id" />
                <field name="source_move_name" optional="hide" />
                <field name="origin_move_id" optional="show" />
                <field name="origin_move_name" optional="hide" />
                <field name="partner_id" optional="show" />
                <field name="account_id" optional="show" />
                <field name="category_id" optional="hide" />
                <field name="tax_repartition_line_id" optional="hide" />
                <field name="ten_day_applied" optional="hide" />
                <field name="override" optional="hide" />
                <field name="gift_recipient_id" optional="hide" />
                <field name="adjustment_id" optional="hide" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="hide"
                />
                <field name="currency_id" column_invisible="True" />
                <field name="balance" sum="Total" optional="hide" />
                <field name="amount" sum="Total" />
            </list>
        </field>
    </record>

    <record id="l10n_de_euer_cash_slice_view_form" model="ir.ui.view">
        <field name="name">l10n_de_euer.cash.slice.form</field>
        <field name="model">l10n_de_euer.cash.slice</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_source"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-university"
                            string="Money Entry"
                            invisible="not source_move_id"
                        />
                        <button
                            name="action_open_origin"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            string="Document"
                            invisible="not origin_move_id"
                        />
                        <button
                            name="action_open_attachments"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-paperclip"
                            invisible="not attachment_count"
                        >
                            <field
                                name="attachment_count"
                                widget="statinfo"
                                string="Receipts"
                            />
                        </button>
                        <button
                            name="action_open_path"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-exchange"
                            string="Path"
                            invisible="not partial_ids"
                        />
                        <button
                            name="action_open_adjustment"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o"
                            string="Profit Correction"
                            invisible="not adjustment_id"
                        />
                        <button
                            name="action_open_assets"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-cubes"
                            string="Assets"
                            invisible="rule != 'asset'"
                        />
                    </div>
                    <group>
                        <group name="field" string="Form Field">
                            <field name="field_code" />
                            <field name="field_id" />
                            <field
                                name="attribution_year"
                                options="{'enable_formatting': false}"
                            />
                            <field name="amount" />
                            <field name="rule" />
                        </group>
                        <group name="money" string="Money">
                            <field name="date" />
                            <field name="kind" />
                            <field name="source_move_id" />
                            <field name="source_move_name" />
                            <field name="source_line_id" />
                            <field name="override" />
                            <field name="ten_day_applied" />
                        </group>
                        <group name="document" string="Document">
                            <field name="origin_move_id" />
                            <field name="origin_move_name" />
                            <field name="origin_line_id" />
                            <field name="document_move_id" />
                            <field name="virtual_part" invisible="not virtual_part" />
                            <field name="account_id" />
                            <field name="partner_id" />
                            <field name="tax_repartition_line_id" />
                            <field name="category_id" />
                        </group>
                        <group name="amounts" string="Amounts">
                            <field name="balance" />
                            <field name="debit" />
                            <field name="credit" />
                            <field name="currency_id" invisible="1" />
                            <field name="path_text" />
                            <field name="run_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group
                            name="gift"
                            string="Gift"
                            invisible="not gift_recipient_id and not gift_bulk"
                        >
                            <field name="gift_recipient_id" />
                            <field name="gift_date" />
                            <field name="gift_bulk" />
                        </group>
                        <group
                            name="correction"
                            string="Profit Correction"
                            invisible="not adjustment_id"
                        >
                            <field name="adjustment_id" />
                        </group>
                    </group>
                    <separator string="Path of the Money" invisible="not partial_ids" />
                    <field
                        name="partial_ids"
                        invisible="not partial_ids"
                        context="{'list_view_ref': 'l10n_de_euer.l10n_de_euer_partial_reconcile_view_list'}"
                    />
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_de_euer_cash_slice_view_pivot" model="ir.ui.view">
        <field name="name">l10n_de_euer.cash.slice.pivot</field>
        <field name="model">l10n_de_euer.cash.slice</field>
        <field name="arch" type="xml">
            <pivot string="EÜR Slices" sample="1">
                <field name="field_code" type="row" />
                <field name="attribution_year" type="col" />
                <field name="amount" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="l10n_de_euer_cash_slice_view_search" model="ir.ui.view">
        <field name="name">l10n_de_euer.cash.slice.search</field>
        <field name="model">l10n_de_euer.cash.slice</field>
        <field name="arch" type="xml">
            <search>
                <field name="field_code" />
                <field name="source_move_id" />
                <field name="origin_move_id" />
                <field name="partner_id" />
                <field name="account_id" />
                <field name="attribution_year" />
                <filter
                    name="filter_fields"
                    string="With Form Field"
                    domain="[('field_code', '!=', False)]"
                />
                <filter
                    name="filter_no_field"
                    string="Without Form Field"
                    domain="[('field_code', '=', False)]"
                />
                <filter
                    name="filter_ten_day"
                    string="Ten-Day Rule Applied"
                    domain="[('ten_day_applied', '=', True)]"
                />
                <group>
                    <filter
                        name="group_field"
                        string="Field"
                        context="{'group_by': 'field_code'}"
                    />
                    <filter
                        name="group_year"
                        string="Year"
                        context="{'group_by': 'attribution_year'}"
                    />
                    <filter
                        name="group_account"
                        string="Account"
                        context="{'group_by': 'account_id'}"
                    />
                    <filter
                        name="group_partner"
                        string="Partner"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        name="group_month"
                        string="Month"
                        context="{'group_by': 'date:month'}"
                    />
                    <filter
                        name="group_kind"
                        string="Kind"
                        context="{'group_by': 'kind'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- partial reconciliations of the path of a slice (spec 7.6 no. 2) -->
    <record id="l10n_de_euer_partial_reconcile_view_list" model="ir.ui.view">
        <field name="name">account.partial.reconcile.list.l10n_de_euer</field>
        <field name="model">account.partial.reconcile</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="id" string="Partial" />
                <field name="max_date" />
                <field name="debit_move_id" />
                <field name="credit_move_id" />
                <field name="company_currency_id" column_invisible="True" />
                <field name="amount" />
                <field name="full_reconcile_id" optional="show" />
                <field name="exchange_move_id" optional="hide" />
            </list>
        </field>
    </record>

    <record id="action_l10n_de_euer_cash_slice" model="ir.actions.act_window">
        <field name="name">EÜR Slices</field>
        <field name="res_model">l10n_de_euer.cash.slice</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="context">{'search_default_filter_fields': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No slices</p>
            <p>
                Slices are the amounts of the journal items at the date the money
                arrived or left. Compute a year to create them.
            </p>
        </field>
    </record>

    <record id="l10n_de_euer_run_view_list" model="ir.ui.view">
        <field name="name">l10n_de_euer.run.list</field>
        <field name="model">l10n_de_euer.run</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date" />
                <field name="company_id" groups="base.group_multi_company" />
                <field
                    name="year_from"
                    string="Year"
                    options="{'enable_formatting': false}"
                />
                <field name="user_id" optional="show" />
                <field name="invariant_ok" />
                <field name="locked" optional="show" />
                <field name="duration" optional="show" />
                <field name="hash" optional="hide" />
            </list>
        </field>
    </record>

    <record id="l10n_de_euer_run_view_form" model="ir.ui.view">
        <field name="name">l10n_de_euer.run.form</field>
        <field name="model">l10n_de_euer.run</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_slices"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-list"
                        >
                            <field
                                name="slice_count"
                                widget="statinfo"
                                string="Slices"
                            />
                        </button>
                    </div>
                    <group>
                        <group name="run" string="Calculation">
                            <field name="company_id" />
                            <field
                                name="year_from"
                                string="Year"
                                options="{'enable_formatting': false}"
                            />
                            <field name="date" />
                            <field name="user_id" />
                            <field name="duration" />
                        </group>
                        <group name="result" string="Result">
                            <field name="invariant_ok" />
                            <field name="locked" />
                            <field name="hash" />
                        </group>
                    </group>
                    <notebook>
                        <page name="totals" string="Field Totals">
                            <field name="totals_text" nolabel="1" />
                        </page>
                        <page name="form_values" string="Form Values">
                            <field name="form_values_text" nolabel="1" />
                        </page>
                        <page name="log" string="Log">
                            <field name="log_text" nolabel="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_de_euer_run" model="ir.actions.act_window">
        <field name="name">EÜR Calculations</field>
        <field name="res_model">l10n_de_euer.run</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No calculation yet</p>
            <p>Compute a year to see its slices and check results.</p>
        </field>
    </record>

    <record id="l10n_de_euer_compute_year_view_form" model="ir.ui.view">
        <field name="name">l10n_de_euer.compute.year.form</field>
        <field name="model">l10n_de_euer.compute.year</field>
        <field name="arch" type="xml">
            <form>
                <p>
                    Computes the receipts and payments of the year from the bookings
                    (§ 11 EStG) and runs the checks of the calculation. Journal
                    entries are only read.
                </p>
                <group>
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="year" options="{'enable_formatting': false}" />
                    <field name="run_assignment_checks" />
                    <field name="run_asset_checks" />
                </group>
                <footer>
                    <button
                        name="action_compute"
                        type="object"
                        string="Compute"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_de_euer_compute_year" model="ir.actions.act_window">
        <field name="name">Compute Year</field>
        <field name="res_model">l10n_de_euer.compute.year</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
