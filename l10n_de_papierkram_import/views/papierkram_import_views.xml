<odoo>
    <record id="papierkram_import_view_form" model="ir.ui.view">
        <field name="name">papierkram.import.form</field>
        <field name="model">papierkram.import</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_check"
                        type="object"
                        string="Check"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_check"
                        type="object"
                        string="Check Again"
                        invisible="state != 'checked'"
                    />
                    <button
                        name="action_import"
                        type="object"
                        string="Import"
                        class="btn-primary"
                        invisible="state != 'checked'"
                        confirm="The data will now be imported and posted. Continue?"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_moves"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-list"
                            invisible="move_count == 0"
                        >
                            <field
                                name="move_count"
                                widget="statinfo"
                                string="Entries"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="state == 'done'" />
                        </h1>
                    </div>
                    <group>
                        <group string="Files from Papierkram">
                            <field
                                name="export_attachment_ids"
                                widget="many2many_binary"
                                readonly="state == 'done'"
                            />
                            <field
                                name="categories_file"
                                filename="categories_filename"
                                readonly="state == 'done'"
                            />
                            <field name="categories_filename" invisible="1" />
                            <field
                                name="assets_file"
                                filename="assets_filename"
                                readonly="state == 'done'"
                            />
                            <field name="assets_filename" invisible="1" />
                            <field
                                name="splits_file"
                                filename="splits_filename"
                                readonly="state == 'done'"
                            />
                            <field name="splits_filename" invisible="1" />
                        </group>
                        <group string="Settings">
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="small_business" readonly="state == 'done'" />
                            <field name="scope" readonly="state == 'done'" />
                            <field
                                name="create_depreciation"
                                invisible="scope == 'open'"
                                readonly="state == 'done'"
                            />
                            <field
                                name="depreciation_until"
                                invisible="not create_depreciation"
                                readonly="state == 'done'"
                            />
                            <field name="sale_journal_id" readonly="state == 'done'" />
                            <field
                                name="purchase_journal_id"
                                readonly="state == 'done'"
                            />
                            <field name="money_journal_id" readonly="state == 'done'" />
                            <field name="misc_journal_id" readonly="state == 'done'" />
                        </group>
                    </group>
                    <field name="warning_count" invisible="1" />
                    <field name="log" nolabel="1" />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="papierkram_import_view_list" model="ir.ui.view">
        <field name="name">papierkram.import.list</field>
        <field name="model">papierkram.import</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="state" />
                <field name="warning_count" />
                <field name="move_count" />
            </list>
        </field>
    </record>

    <record id="papierkram_import_action" model="ir.actions.act_window">
        <field name="name">Papierkram Import</field>
        <field name="res_model">papierkram.import</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Import data from Papierkram</p>
            <p>
                In Papierkram, create one export "Complete (CSV, PDF)" per year under
                Settings → Export and Import and upload all files here.
            </p>
        </field>
    </record>

    <menuitem
        id="papierkram_import_menu"
        name="Papierkram Import"
        parent="account.menu_finance_configuration"
        action="papierkram_import_action"
        sequence="90"
        groups="account.group_account_manager"
    />
</odoo>
