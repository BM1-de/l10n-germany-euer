<odoo>
    <record id="papierkram_import_view_form" model="ir.ui.view">
        <field name="name">papierkram.import.form (EÜR asset register)</field>
        <field name="model">papierkram.import</field>
        <field
            name="inherit_id"
            ref="l10n_de_papierkram_import.papierkram_import_view_form"
        />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_euer_assets"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-cubes"
                    invisible="euer_asset_count == 0"
                >
                    <field name="euer_asset_count" widget="statinfo" string="Assets" />
                </button>
            </div>
            <xpath expr="//header" position="inside">
                <button
                    name="action_euer_take_over_assets"
                    type="object"
                    string="Take Over Fixed Assets (EÜR)"
                    invisible="state != 'done' or euer_asset_count != 0"
                    confirm="The fixed assets are entered in the asset register with their Papierkram book value at the takeover date. Continue?"
                />
            </xpath>
            <field name="depreciation_until" position="after">
                <field name="euer_asset_takeover" readonly="state == 'done'" />
                <field
                    name="euer_takeover_date"
                    invisible="not euer_asset_takeover"
                    required="euer_asset_takeover"
                    readonly="state == 'done'"
                />
            </field>
        </field>
    </record>
</odoo>
