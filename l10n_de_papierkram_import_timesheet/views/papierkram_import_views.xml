<odoo>
    <record id="papierkram_import_view_form" model="ir.ui.view">
        <field name="name">papierkram.import.form (time entries)</field>
        <field name="model">papierkram.import</field>
        <field
            name="inherit_id"
            ref="l10n_de_papierkram_import.papierkram_import_view_form"
        />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_timesheets"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-clock-o"
                    invisible="timesheet_count == 0"
                >
                    <field
                        name="timesheet_count"
                        widget="statinfo"
                        string="Time Entries"
                    />
                </button>
                <button
                    name="action_view_sale_orders"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-dollar"
                    invisible="sale_order_count == 0"
                >
                    <field
                        name="sale_order_count"
                        widget="statinfo"
                        string="Sales Orders"
                    />
                </button>
            </div>
            <field name="splits_filename" position="after">
                <field
                    name="unbilled_file"
                    filename="unbilled_filename"
                    readonly="state == 'done'"
                />
                <field name="unbilled_filename" invisible="1" />
            </field>
            <field name="misc_journal_id" position="after">
                <field name="time_entries" readonly="state == 'done'" />
                <field name="import_products" readonly="state == 'done'" />
            </field>
        </field>
    </record>
</odoo>
